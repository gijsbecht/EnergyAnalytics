[Unit]
Description=Energy Analytics – collect APSystems solar readings for previous day
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/EnergyAnalytics

# Environment variables – edit these for your setup
Environment="APSYSTEMS_APP_ID=your_app_id"
Environment="APSYSTEMS_APP_SECRET=your_app_secret"
Environment="APSYSTEMS_SID=your_system_id"
Environment="APSYSTEMS_ECU_ID=your_ecu_id"
Environment="DB_PATH=/home/pi/energy.db"

ExecStart=/home/pi/EnergyAnalytics/.venv/bin/python -m src.main_apsystems

# Logging goes to systemd journal (view with: journalctl -u apsystems.service)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apsystems

# Do not restart – if the API is down for a day the data is simply missing.
# The timer's Persistent=true will retry on next boot if the run was missed.
Restart=no

[Install]
WantedBy=multi-user.target
