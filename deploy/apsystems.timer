[Unit]
Description=Energy Analytics – fetch APSystems solar data daily
Requires=apsystems.service

[Timer]
# Run at 02:00 local time every day (fetches previous day's data)
OnCalendar=02:00
RandomizedDelaySec=300

# If a run was missed (e.g. RPi was off), run immediately on next boot
Persistent=true

[Install]
WantedBy=timers.target
